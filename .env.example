# ─── Telegram Bot ───────────────────────────────────────────
# توکن ربات تلگرام (از @BotFather دریافت کنید)
BOT_TOKEN=1234567890:ABCdefGhIjKlMnOpQrStUvWxYz

# شناسه عددی ادمین‌ها (می‌توانید چند عدد با کاما جدا کنید)
# برای پیدا کردن ID: به @userinfobot پیام دهید
ADMIN_IDS=123456789,987654321

# ─── x-ui Panel ─────────────────────────────────────────────
# آدرس کامل پنل x-ui (با پورت)
XUI_URL=http://YOUR_SERVER_IP:54321

# نام کاربری پنل
XUI_USER=admin

# رمز عبور پنل
XUI_PASS=admin

# شناسه اینباند که سرویس‌ها روی آن ساخته می‌شوند
XUI_INBOUND_ID=1

# آی‌پی یا دامنه سرور (برای ساخت لینک اشتراک)
SERVER_HOST=your.domain.com

# ─── Target Telegram Group/Channel ──────────────────────────
# شناسه گروه یا کانال تلگرام که لینک‌ها به آن ارسال می‌شود
# برای گروه/کانال از فرمت -100XXXXXXXXXX استفاده کنید
# خالی بگذارید اگر نمی‌خواهید به جایی ارسال شود
TARGET_CHAT_ID=-1001234567890

# ─── SSL ────────────────────────────────────────────────────
# اگر پنل SSL دارد و سرتیفیکیت خودامضا است: false
VERIFY_SSL=false
