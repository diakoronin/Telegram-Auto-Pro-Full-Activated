#!/usr/bin/env bash
# saka-bot — install / update / systemd / DB password / .env helpers (ASCII only).
# Symlink to /usr/local/bin after clone:  sudo ln -sf /path/to/repo/scripts/saka-bot /usr/local/bin/saka-bot
# Or set:  export SAKA_BOT_ROOT=/path/to/repo

set -euo pipefail

UNIT="${SYSTEMD_UNIT:-${SAKA_BOT_UNIT:-telegram-sales-bot.service}}"

die() { echo "ERROR: $*" >&2; exit 1; }
log() { echo "[saka-bot] $*"; }

resolve_root() {
  if [[ -n "${SAKA_BOT_ROOT:-}" ]]; then
    echo "$(cd "$SAKA_BOT_ROOT" && pwd)"
    return
  fi
  local self real
  self="${BASH_SOURCE[0]}"
  real="$(readlink -f "$self" 2>/dev/null || echo "$self")"
  local dir
  dir="$(cd "$(dirname "$real")/.." && pwd)"
  if [[ -f "$dir/main.py" && -f "$dir/requirements.txt" ]]; then
    echo "$dir"
    return
  fi
  for c in /opt/telegram-sales-bot "$HOME/telegram-sales-bot" /root/telegram-sales-bot; do
    if [[ -f "$c/main.py" ]]; then
      echo "$c"
      return
    fi
  done
  die "Set SAKA_BOT_ROOT or run from repo (main.py not found)."
}

run_sctl() {
  if [[ "$(id -u)" -eq 0 ]]; then
    systemctl "$@"
  else
    sudo systemctl "$@"
  fi
}

run_journal() {
  if [[ "$(id -u)" -eq 0 ]]; then
    journalctl "$@"
  else
    sudo journalctl "$@"
  fi
}

ROOT="$(resolve_root)"
cd "$ROOT"
[[ -f main.py ]] || die "Not a bot install: $ROOT"

usage() {
  cat <<'EOF'
Usage: saka-bot <command>   (set SAKA_BOT_ROOT if not symlinked from repo)

  install       Print first-time install examples (curl / install.sh)
  update        Safe code update: stop bot, git pull, pip, restart systemd if was on
  reinstall     Rebuild .venv + pip install (no git); then restart if systemd was on
  fresh [BR]    Full wipe + install latest (sudo). Default BR=main. Env: FRESH_DROP_DB=1
  restart       systemctl restart
  start         systemctl start
  stop          systemctl stop
  status        systemctl status
  logs          journalctl last 80 lines (saka-bot logs -f to follow)
  logs-save     Write last 500 log lines to ROOT/logs/journal-snippet.txt (for bug reports)
  diagnose      scripts/diagnose.sh
  db-info       Show DB user, host, port, database from DATABASE_URL (password never shown)
  db-password   sudo: ALTER ROLE password + rewrite DATABASE_URL in .env
  set-token     Hidden prompt -> BOT_TOKEN in .env
  set-owner     Prompt -> OWNER_ID in .env (Telegram numeric admin id)
  env-show      .env keys; BOT_TOKEN / DATABASE_URL / OWNER_ID masked
  help          This text

Env: SAKA_BOT_ROOT, SAKA_BOT_UNIT (systemd unit name), SYSTEMD_UNIT (alias)

Examples:
  sudo ln -sf /root/telegram-sales-bot/scripts/saka-bot /usr/local/bin/saka-bot
  export SAKA_BOT_ROOT=/root/telegram-sales-bot
  saka-bot update
  saka-bot db-info
  sudo saka-bot db-password
  saka-bot logs-save && cat /root/telegram-sales-bot/logs/journal-snippet.txt
  FRESH_DROP_DB=1 saka-bot fresh main   # also drop old Postgres DB from .env before wipe
EOF
}

cmd_fresh() {
  local br="${1:-${BRANCH:-main}}"
  [[ -f "$ROOT/scripts/fresh-install.sh" ]] || die "scripts/fresh-install.sh missing. git pull first."
  if [[ "$(id -u)" -ne 0 ]]; then
    exec sudo env SAKA_BOT_UNIT="$UNIT" bash "$ROOT/scripts/fresh-install.sh" "$ROOT" "$br"
  fi
  export SAKA_BOT_UNIT="$UNIT"
  exec bash "$ROOT/scripts/fresh-install.sh" "$ROOT" "$br"
}

cmd_update() {
  [[ -f scripts/update.sh ]] || die "scripts/update.sh missing. git pull first."
  exec bash scripts/update.sh
}

pick_python() {
  for c in python3.12 python3.11 python3; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(0 if sys.version_info>=(3,11) else 1)' 2>/dev/null; then
      echo "$c"
      return 0
    fi
  done
  die "Need Python 3.11+ for reinstall"
}

cmd_reinstall() {
  local had=0
  if run_sctl is-active --quiet "$UNIT" 2>/dev/null; then
    had=1
    log "Stopping $UNIT"
    run_sctl stop "$UNIT" || true
    sleep 1
  fi
  pkill -f "${ROOT}/main.py" 2>/dev/null || true
  sleep 1
  local py
  py="$(pick_python)"
  log "Removing .venv and recreating with $py"
  rm -rf .venv
  "$py" -m venv .venv
  # shellcheck disable=SC1091
  source .venv/bin/activate
  pip install -q -U pip wheel setuptools
  pip install -q -r requirements.txt
  log "venv rebuilt OK"
  if [[ "$had" -eq 1 ]]; then
    run_sctl start "$UNIT" || die "systemctl start failed"
    log "Started $UNIT"
  else
    log "systemd was off; run: saka-bot start   or: scripts/run.sh"
  fi
}

cmd_db_info() {
  [[ -f .env ]] || die ".env missing"
  python3 <<'PY' || die "db-info failed"
import sys
from pathlib import Path
from urllib.parse import unquote, urlparse

def load_env(path):
    d = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, _, v = line.partition("=")
        d[k.strip()] = v.strip()
    return d

url = load_env(Path(".env")).get("DATABASE_URL", "")
if not url.startswith("postgresql"):
    print("DATABASE_URL is not postgres URL", file=sys.stderr)
    sys.exit(1)
u = urlparse(url.replace("postgresql+asyncpg", "postgresql", 1))
user = unquote(u.username or "")
pw = u.password
db = (u.path or "/").lstrip("/")
print("Current DATABASE_URL (parsed, password not shown):")
print("  user:", user or "(none)")
print("  password:", "(set)" if pw else "(empty)")
print("  host:", u.hostname or "127.0.0.1")
print("  port:", u.port or 5432)
print("  database:", db or "(none)")
PY
}

cmd_logs_save() {
  mkdir -p "$ROOT/logs"
  local out="$ROOT/logs/journal-snippet.txt"
  run_journal -u "$UNIT" -n 500 --no-pager > "$out"
  log "Wrote $out (attach this file when reporting bugs)"
}

cmd_db_password() {
  [[ -f .env ]] || die ".env missing"
  if [[ "$(id -u)" -ne 0 ]]; then
    die "Run: sudo saka-bot db-password"
  fi
  command -v psql >/dev/null || die "Install postgresql-client"
  [[ -r /dev/tty ]] || die "Need a TTY"
  python3 <<'PY' || die "db-password failed"
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote, unquote, urlparse

def load_env(path):
    d = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, _, v = line.partition("=")
        d[k.strip()] = v.strip()
    return d

env = load_env(Path(".env"))
url = env.get("DATABASE_URL", "")
if not url.startswith("postgresql+asyncpg://"):
    print("DATABASE_URL must start with postgresql+asyncpg://", file=sys.stderr)
    sys.exit(1)
u = urlparse(url.replace("postgresql+asyncpg", "postgresql", 1))
user = unquote(u.username or "")
if not user:
    print("no user in DATABASE_URL", file=sys.stderr)
    sys.exit(1)
newp = input("New database password for role %r: " % (user,))
if len(newp) < 8:
    print("password too short (min 8)", file=sys.stderr)
    sys.exit(1)
ep = newp.replace("'", "''")
subprocess.run(
    [
        "sudo",
        "-u",
        "postgres",
        "psql",
        "-v",
        "ON_ERROR_STOP=1",
        "-c",
        'ALTER ROLE "%s" WITH PASSWORD \'%s\';' % (user.replace('"', ""), ep),
    ],
    check=True,
)
host = u.hostname or "127.0.0.1"
port = u.port or 5432
db = (u.path or "/").lstrip("/")
nu = "postgresql+asyncpg://%s:%s@%s:%s/%s" % (
    quote(user, safe=""),
    quote(newp, safe=""),
    host,
    port,
    quote(db, safe=""),
)
text = Path(".env").read_text(encoding="utf-8")
lines = []
for line in text.splitlines():
    if line.startswith("DATABASE_URL="):
        lines.append("DATABASE_URL=" + nu)
    else:
        lines.append(line)
Path(".env").write_text("\n".join(lines) + "\n", encoding="utf-8")
Path(".env").chmod(0o600)
print("OK: ALTER ROLE and .env updated. Run: saka-bot restart")
PY
}

cmd_set_token() {
  [[ -f .env ]] || die ".env missing"
  [[ -r /dev/tty ]] || die "Need a TTY for hidden input"
  printf "New BOT_TOKEN: " > /dev/tty
  read -rs tok < /dev/tty || true
  printf "\n" > /dev/tty
  [[ -n "${tok:-}" ]] || die "empty token"
  BOT_TOKEN="$tok" ROOT="$ROOT" python3 <<'PY'
import os
from pathlib import Path
root = Path(os.environ["ROOT"])
tok = os.environ["BOT_TOKEN"]
p = root / ".env"
lines = []
for line in p.read_text(encoding="utf-8").splitlines():
    if line.startswith("BOT_TOKEN="):
        lines.append("BOT_TOKEN=" + tok)
    else:
        lines.append(line)
p.write_text("\n".join(lines) + "\n", encoding="utf-8")
p.chmod(0o600)
print("OK: BOT_TOKEN updated. Run: saka-bot restart")
PY
}

cmd_set_owner() {
  [[ -f .env ]] || die ".env missing"
  read -r -p "New OWNER_ID (numeric Telegram id): " oid
  [[ -n "${oid:-}" ]] || die "empty"
  OWNER_ID="$oid" ROOT="$ROOT" python3 <<'PY'
import os
from pathlib import Path
root = Path(os.environ["ROOT"])
oid = os.environ["OWNER_ID"].strip()
p = root / ".env"
lines = []
for line in p.read_text(encoding="utf-8").splitlines():
    if line.startswith("OWNER_ID="):
        lines.append("OWNER_ID=" + oid)
    else:
        lines.append(line)
p.write_text("\n".join(lines) + "\n", encoding="utf-8")
p.chmod(0o600)
print("OK: OWNER_ID updated. Run: saka-bot restart")
PY
}

cmd_env_show() {
  [[ -f .env ]] || die ".env missing"
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// }" ]] && continue
    if [[ "$line" =~ ^(BOT_TOKEN|DATABASE_URL|OWNER_ID)= ]]; then
      k="${line%%=*}"
      echo "$k=(set, hidden)"
    else
      echo "$line"
    fi
  done < .env
}

cmd_install() {
  log "First-time server install (see README). Examples:"
  echo "  sudo bash $ROOT/scripts/install.sh /opt/telegram-sales-bot main"
  echo "  curl -fsSL \"https://raw.githubusercontent.com/USER/REPO/\${BR}/scripts/quick.sh\" | bash -s -- \$HOME/telegram-sales-bot \$BR"
  echo "After install: sudo ln -sf $ROOT/scripts/saka-bot /usr/local/bin/saka-bot"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    install) cmd_install ;;
    update) cmd_update ;;
    reinstall) cmd_reinstall ;;
    fresh|fresh-install) cmd_fresh "$@" ;;
    restart) run_sctl restart "$UNIT" ;;
    start) run_sctl start "$UNIT" ;;
    stop) run_sctl stop "$UNIT" ;;
    status) run_sctl status "$UNIT" --no-pager ;;
    logs)
      if [[ "${1:-}" == "-f" ]]; then
        run_journal -u "$UNIT" -f
      else
        run_journal -u "$UNIT" -n 80 --no-pager
      fi
      ;;
    logs-save) cmd_logs_save ;;
    diagnose)
      [[ -f scripts/diagnose.sh ]] || die "scripts/diagnose.sh missing"
      bash scripts/diagnose.sh "$ROOT"
      ;;
    db-info) cmd_db_info ;;
    db-password) cmd_db_password ;;
    set-token) cmd_set_token ;;
    set-owner) cmd_set_owner ;;
    env-show) cmd_env_show ;;
    help|-h|--help|"") usage ;;
    *) die "unknown command: $cmd (try: saka-bot help)" ;;
  esac
}

main "$@"
