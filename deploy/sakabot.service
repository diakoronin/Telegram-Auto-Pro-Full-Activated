[Unit]
Description=SakaBot Telegram VPN Sales Bot
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/sakabot
EnvironmentFile=/opt/sakabot/.env
ExecStart=/opt/sakabot/.venv/bin/python /opt/sakabot/main.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
